# Control Plane 环境（ADR-0001）；install_cp.sh 首次安装会复制本文件并生成随机 token
DUDUDA_CP_TOKEN=change-me
DUDUDA_CP_AUDIT=/opt/dududa20-prototype/data/cp_audit.jsonl
DUDUDA_MEMORY_FILE=/root/data/plugins/dududa20/data/memory.json
DUDUDA_EVAL_DIR=/opt/dududa20-prototype/data/traces-eval
DUDUDA_MCP_ACCESS=/opt/dududa20-prototype/data/mcp_access.json
